{
  "name": "simple-auto-complete",
  "displayName": "Simple Auto Complete",
  "description": "AI-powered code completion using Local AI API",
  "publisher": "chenzyadb",
  "repository": "https://github.com/chenzyadb/Simple-Auto-Complete",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Simple Auto Complete",
      "properties": {
        "simpleAutoComplete.apiEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:1234",
          "description": "OpenAI API endpoint URL."
        },
        "simpleAutoComplete.timeOut": {
          "type": "number",
          "default": 1000,
          "minimum": 500,
          "maximum": 5000,
          "description": "Request API Timeout(ms)."
        },
        "simpleAutoComplete.maxContextLines": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "Maximum number of lines to include as context for AI completion."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
